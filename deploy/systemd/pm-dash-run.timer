# Weekdays at 07:00 in the host's time zone (OP-07). Persistent: a run missed while
# the host was off starts at the next boot. The second entry covers a host that was
# asleep at 07:00; R-R3 keeps it to one run a day.
[Unit]
Description=PM Dash weekday run timer

[Timer]
OnCalendar=Mon..Fri *-*-* 07:00:00
OnCalendar=Mon..Fri *-*-* 09:30:00
Persistent=true

[Install]
WantedBy=timers.target
